<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.AttendanceApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash Screen theme using androidx.core.splashscreen -->
    <style name="Theme.AttendanceApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/gbu_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AttendanceApp</item>
    </style>
</resources>
